        <Grid Grid.Row="2"><local:MarkdownView x:Name="FilePreview" VerticalScrollBarVisibility="Auto"/><TextBox x:Name="FileEditor" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="FileTextEdited"/>
