    <Border x:Name="ChatSetupDialog" Grid.RowSpan="2" Background="#E010141C" Visibility="Collapsed"><Border Background="#1B2330" CornerRadius="16" Width="530" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
