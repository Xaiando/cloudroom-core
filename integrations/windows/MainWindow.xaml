    <Border x:Name="HandoffDialog" Grid.RowSpan="2" Background="#E010141C" Visibility="Collapsed"><Border Background="#1B2330" CornerRadius="16" Width="620" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto"><StackPanel>
