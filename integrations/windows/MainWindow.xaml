<Window x:Class="Cloudroom.Desktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Cloudroom.Desktop"
  Title="Cloud Bee" Width="1220" Height="820" MinWidth="920" MinHeight="660" WindowStartupLocation="CenterScreen"
  Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize"
  Loaded="WindowLoaded" Closed="WindowClosed">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#10141B" BorderBrush="#222A37" BorderThickness="0,0,0,1">
      <Grid Margin="18,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="⬡" Foreground="{StaticResource Accent}" FontSize="19" Margin="0,0,8,0"/><TextBlock Text="Cloud Bee" FontWeight="SemiBold"/><TextBlock Text=" / Windows" Foreground="{StaticResource Muted}" FontSize="12" Margin="4,2,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="─" Width="46" Style="{StaticResource Quiet}" Click="MinimizeWindow" AutomationProperties.Name="Minimize"/>
          <Button Content="□" Width="46" Style="{StaticResource Quiet}" Click="MaximizeWindow" AutomationProperties.Name="Maximize"/>
          <Button Content="✕" Width="46" Style="{StaticResource Quiet}" Click="CloseWindow" AutomationProperties.Name="Close window"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#151B24" BorderBrush="#27303E" BorderThickness="0,0,1,0">
        <Grid Margin="16,24,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="YOUR WORKSPACE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,14"/><Button x:Name="NewButton" Content="＋   New session" Style="{StaticResource Primary}" HorizontalContentAlignment="Left" Click="ShowNewSession" IsEnabled="False"/>
            <Button x:Name="CouncilNavButton" Content="⬡   Council of AI" ToolTip="Select GPT, Grok, Claude, Qwen and DeepSeek for a shared conversation" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Click="ShowCouncil" Margin="0,12,0,0" IsEnabled="False"/>
            <Button Content="◷   Automations" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Click="ShowAutomations" Margin="0,4,0,0"/>
            <Button Content="◇   Plugins" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Click="ShowPlugins" Margin="0,4,0,0"/>
            <Button Content="▧   Workspace files" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Click="ShowWorkspaceFiles" Margin="0,4,0,0"/><Button Content="▤   Docs · Memory · Tasks" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Click="ShowLibrary" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="4,20,4,12"><Grid><TextBlock Text="SESSIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SessionCount" Text="0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid><TextBox x:Name="ThreadSearch" Margin="0,10,0,8" Padding="9,7" FontSize="12" ToolTip="Search title, model, folder or collection" TextChanged="ThreadSearchChanged"/><WrapPanel><CheckBox x:Name="ThreadArchived" Content="Archived" Click="ThreadFilterChanged" FontSize="11" VerticalAlignment="Center"/><Button Content="Organize selected" Click="ShowThreadOrganization" Style="{StaticResource Quiet}" Padding="8,4" FontSize="11" Margin="6,0,0,0"/></WrapPanel></StackPanel>
          <ListBox x:Name="SessionList" Grid.Row="2" Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SessionSelected" AutomationProperties.Name="Sessions">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" CornerRadius="8" Padding="12,12" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#2B2B43"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#555168"/><Setter TargetName="Selection" Property="BorderThickness" Value="1"/><Setter TargetName="Selection" Property="Padding" Value="11,11"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="3" BorderBrush="#2A3341" BorderThickness="0,1,0,0" Padding="2,18,2,0" Margin="0,12,0,0"><StackPanel>
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#6E7889" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionLabel" Text="Connecting to Core…" FontSize="12"/></StackPanel>
            <TextBlock x:Name="AccountLabel" Text="Local runtime" FontSize="11" Foreground="{StaticResource Muted}" Margin="15,6,0,10"/>
            <Button Content="Chat connections" Style="{StaticResource Quiet}" Click="ShowChatSetup"/><Button Content="⚙   Connection settings" Style="{StaticResource Quiet}" Click="ShowConnection"/>
          </StackPanel></Border>
        </Grid>
      </Border>
      <Grid x:Name="ConversationPane" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#27303E" BorderThickness="0,0,0,1" Padding="30,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="HeaderTitle" Text="A little space to build" FontSize="18" FontWeight="SemiBold"/><Border Background="#232B3A" CornerRadius="4" Padding="7,3" Margin="12,0,0,0"><TextBlock x:Name="StateLabel" Text="LOCAL" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border></StackPanel><TextBlock x:Name="HeaderSubtitle" Text="Your coding agent, on your Windows machine." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="FolderButton" Content="↗ Folder" Style="{StaticResource Quiet}" ToolTip="Open the session folder" Click="OpenFolder" IsEnabled="False"/><Button x:Name="PauseButton" Content="Pause queue" Style="{StaticResource Quiet}" Click="PauseQueue" IsEnabled="False"/><Button x:Name="InterruptButton" Content="Interrupt" Style="{StaticResource Quiet}" Click="Interrupt" IsEnabled="False"/><Button x:Name="CloseButton" Content="Close" Style="{StaticResource Quiet}" Click="CloseSession" IsEnabled="False"/></StackPanel>
        </Grid></Border>
        <StackPanel Grid.Row="1">
          <Border BorderBrush="#27303E" BorderThickness="0,0,0,1" Padding="24,8"><StackPanel>
            <StackPanel Orientation="Horizontal"><Button x:Name="ChatModeButton" Content="Chat" Tag="chat" Click="ChangeMode" Margin="0,0,8,0"/><Button x:Name="WorkModeButton" Content="Work" Tag="work" Click="ChangeMode" Margin="0,0,12,0"/><Button Content="Council of AI" Click="ShowCouncil" Style="{StaticResource Quiet}"/></StackPanel>
            <TextBlock x:Name="ModeNote" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,7,0,0"/><TextBlock x:Name="BackgroundWork" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0"/><ProgressBar x:Name="RuntimeProgress" Height="3" Margin="0,6,0,0" Visibility="Collapsed" ToolTip="Core reports that this conversation or its background Work is active"/>
          </StackPanel></Border>
          <Border x:Name="GroupBar" Visibility="Collapsed" BorderBrush="#27303E" BorderThickness="0,0,0,1" Padding="24,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox x:Name="GroupTabs" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="GroupTabSelected" AutomationProperties.Name="Models in this chat">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tab" CornerRadius="8" Padding="12,7" Background="#19212D" BorderBrush="#27303E" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#2B2B43"/><Setter TargetName="Tab" Property="BorderBrush" Value="#514A76"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#555168"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Ink}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <CheckBox x:Name="SendAllCheck" Grid.Column="1" Content="Send to all models" IsChecked="True" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Untick to message only the model in the selected tab"/>
          </Grid></Border>
          <Border x:Name="ErrorBanner" Background="#342834" Padding="24,12" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="#FFC7CF" TextWrapping="Wrap"/></Border>
        </StackPanel>
        <Grid Grid.Row="2">
          <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,30" MaxWidth="610">
            <Border Width="68" Height="68" CornerRadius="21" Background="#25233D" BorderBrush="#514A76" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,24"><TextBlock Text="⬡" FontSize="40" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="What are we building?" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Think together. Build with purpose." Foreground="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,28"/>
            <UniformGrid Columns="3" Margin="0,6,0,0">
              <Button Click="ChooseSuggestion" Tag="Explore this project and explain its structure." Margin="0,0,10,0" Padding="16,18" Background="#19212D"><StackPanel><TextBlock Text="⌘" Foreground="{StaticResource Accent}" FontSize="22"/><TextBlock Text="Explore a project" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="Find your way around&#10;an unfamiliar codebase." Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19"/></StackPanel></Button>
              <Button Click="ChooseSuggestion" Tag="Help me implement a new feature in this project. Start by asking what I want to build." Margin="0,0,10,0" Padding="16,18" Background="#19212D"><StackPanel><TextBlock Text="◇" Foreground="{StaticResource Accent}" FontSize="22"/><TextBlock Text="Build something" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="Turn a small idea into&#10;working software." Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19"/></StackPanel></Button>
              <Button Click="ChooseSuggestion" Tag="Review this project for bugs and suggest the most useful tests." Padding="16,18" Background="#19212D"><StackPanel><TextBlock Text="✓" Foreground="{StaticResource Accent}" FontSize="22"/><TextBlock Text="Make it better" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="Fix a bug, add tests,&#10;or clean things up." Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19"/></StackPanel></Button>
            </UniformGrid>
          </StackPanel>
          <ListBox x:Name="ConversationList" Background="Transparent" BorderThickness="0" Margin="24,14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" AutomationProperties.Name="Conversation">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,20"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border Padding="20,16" CornerRadius="12" Background="#171E29" BorderBrush="#263042" BorderThickness="1"><StackPanel>
              <Grid Visibility="{Binding IsMessage, Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,12,0,0"><local:MarkdownView SourceText="{Binding Text, Mode=OneWay}"/><Button Content="Copy source" Tag="{Binding Text}" Click="CopyMessageSource" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="8,4" FontSize="10"/></StackPanel></Grid>
              <Expander Visibility="{Binding IsTool, Converter={StaticResource Visible}}" Foreground="{StaticResource Muted}"><Expander.Header><TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/></Expander.Header><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0" Margin="0,12,0,0" MaxHeight="260" VerticalScrollBarVisibility="Auto"/></Expander>
            </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border x:Name="CouncilPanel" Visibility="Collapsed" Background="{StaticResource Bg}" Padding="24,16"><DockPanel>
            <StackPanel DockPanel.Dock="Top"><Button Content="Back to conversation" Click="DismissGroupComparison" HorizontalAlignment="Right" Style="{StaticResource Quiet}"/><TextBlock Text="Council of AI" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Compare independent answers. Use Send to all models to broadcast. Each model keeps its own mode and authorization." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><TextBlock Text="Broadcast and comparison · autonomous delegation and consensus are not implemented." Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/></StackPanel>
            <ListBox x:Name="CouncilAnswers" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Background="#171E29" BorderBrush="#414358" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Role}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,10"/><local:MarkdownView SourceText="{Binding Text}" ContextSession="{Binding SourceSession}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </DockPanel></Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="30,4,30,16">
          <TextBlock x:Name="QueueLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,0,0,8"/>
          <Border Background="#1B2330" BorderBrush="#414358" BorderThickness="1" CornerRadius="14" Padding="14,8,12,12"><StackPanel>
            <Grid><TextBox x:Name="Composer" Height="82" Background="Transparent" BorderThickness="0" Padding="6,10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ComposerKeyDown" AutomationProperties.Name="Message"/><TextBlock Text="Describe what you'd like to work on…" Foreground="#7F8BA1" Margin="7,12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Composer}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="HarnessPicker" Width="110" Margin="0,0,8,0" SelectionChanged="HarnessChanged" AutomationProperties.Name="Agent"/><ComboBox x:Name="ModelPicker" Width="195" SelectionChanged="ModelChanged" AutomationProperties.Name="Model"/><ComboBox x:Name="EffortPicker" Width="105" Margin="8,0,0,0" AutomationProperties.Name="Reasoning effort"/></StackPanel><Button x:Name="SendButton" Grid.Column="1" Content="Send  ↗" Style="{StaticResource Primary}" Padding="18,9" Click="SendMessage" IsEnabled="False"/></Grid>
          </StackPanel></Border>
          <Grid Margin="4,10,4,0"><TextBlock Text="Enter to send · Shift+Enter for a new line" Foreground="#7F8BA1" FontSize="10"/><TextBlock x:Name="RuntimeLabel" Text="LOCAL" Foreground="#7F8BA1" FontSize="10" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
      </Grid>
      <Border x:Name="ExtensionsPane" Grid.Column="1" Background="{StaticResource Bg}" Visibility="Collapsed" Padding="26,22"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><Button DockPanel.Dock="Right" Content="← Conversation" Click="BackToConversation" Style="{StaticResource Quiet}"/><StackPanel><TextBlock x:Name="ExtensionTitle" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ExtensionSubtitle" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,16,16"/></StackPanel></DockPanel>
        <TextBlock x:Name="ExtensionsError" Grid.Row="1" Foreground="#FFC7CF" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid x:Name="AutomationsView" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14"><Button Content="＋ New automation" Click="NewAutomation" Style="{StaticResource Primary}"/><Button Content="Edit selected" Click="EditAutomation" Margin="8,0,0,0"/><Button Content="Refresh" Click="RefreshExtensionsClicked" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></DockPanel>
          <ListBox x:Name="AutomationList" Grid.Row="1" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="AutomationSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#171E29" BorderBrush="#2A3341" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Run now" Tag="{Binding Id}" Click="RunAutomation" Padding="10,7"/><Button Content="{Binding PauseLabel}" Tag="{Binding Id}" Click="ToggleAutomation" Margin="6,0,0,0" Padding="10,7"/><Button Content="Delete" Tag="{Binding Id}" Click="DeleteAutomation" Margin="6,0,0,0" Style="{StaticResource Quiet}" Padding="10,7"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <DockPanel Grid.Row="2" Margin="0,16,0,10"><TextBlock Text="RUN HISTORY" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Open Work transcript" Click="OpenAutomationWork" Style="{StaticResource Quiet}" Margin="6,0,0,0"/><Button DockPanel.Dock="Right" Content="Cancel active run" Click="CancelAutomationRun" Style="{StaticResource Quiet}" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="AutomationRuns" Background="#171E29" Foreground="{StaticResource Ink}" BorderThickness="0" SelectionChanged="AutomationRunSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox x:Name="AutomationOutput" Grid.Column="1" Margin="12,0,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></Grid>
        </Grid>
        <Grid x:Name="PluginsView" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><ComboBox x:Name="PluginFilter" Width="170" SelectedIndex="0" SelectionChanged="PluginFilterChanged"><ComboBoxItem Content="Installed"/><ComboBoxItem Content="Browse native ports"/></ComboBox><Button Content="Refresh" Click="RefreshExtensionsClicked" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></StackPanel>
          <ListBox x:Name="PluginList" Grid.Row="1" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="PluginSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#171E29" BorderBrush="#2A3341" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,16,7"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Accent}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding ActionLabel}" Tag="{Binding Id}" Click="TogglePlugin"/><Button Content="Uninstall" Tag="{Binding Id}" Click="UninstallPlugin" Style="{StaticResource Quiet}" Margin="8,0,0,0" IsEnabled="{Binding Installed}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel x:Name="PluginSettingsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="CUSTOM INSTRUCTIONS" FontSize="11" Foreground="{StaticResource Muted}"/><TextBox x:Name="PluginInstructions" Height="115" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10"/><Button Content="Save settings" Click="SavePluginSettings" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></StackPanel>
          <TextBlock Grid.Row="3" Text="Native ports of the original features. Other original plugins require individual Windows integrations." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/>
        </Grid>
        <Grid x:Name="LibraryView" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12"><ComboBox x:Name="LibraryKind" Width="115" SelectedIndex="0" SelectionChanged="LibraryKindChanged"><ComboBoxItem Content="Docs" Tag="docs"/><ComboBoxItem Content="Memory" Tag="memory"/><ComboBoxItem Content="Tasks" Tag="tasks"/></ComboBox><TextBlock Text="Search" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="LibrarySearch" Width="200" Margin="8,0,0,0" TextChanged="LibrarySearchChanged" ToolTip="Search titles, content and tags"/><CheckBox x:Name="LibraryArchived" Content="Archived" Margin="12,0" VerticalAlignment="Center" Click="LibraryFilterChanged"/><Button Content="Refresh list" Click="RefreshLibraryClicked" Style="{StaticResource Quiet}"/><Button x:Name="LibraryEnable" Content="Install / enable" Click="EnableLibraryPlugin" Margin="8,0,0,0"/></WrapPanel>
          <TextBlock x:Name="LibraryNotice" Grid.Row="1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,14,0"><Button DockPanel.Dock="Top" Content="＋ New entry" Click="NewLibraryEntry" Style="{StaticResource Primary}" Margin="0,0,0,10"/><ListBox x:Name="LibraryList" Background="#171E29" Foreground="{StaticResource Ink}" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="LibrarySelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
            <Grid x:Name="LibraryEditor" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="LibraryTitle" ToolTip="Title" TextChanged="LibraryEdited" MaxLength="160"/>
              <WrapPanel Grid.Row="1" Margin="0,10,0,0"><ComboBox x:Name="LibraryWorkspace" Width="240" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="LibraryOptionEdited" ToolTip="Workspace scope"/><TextBox x:Name="LibraryTags" Width="210" ToolTip="Tags, separated by commas" Margin="10,0,0,0" TextChanged="LibraryEdited"/></WrapPanel>
