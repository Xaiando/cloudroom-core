      <TextBlock Text="Relevant context"/><TextBox x:Name="HandoffContext" TextWrapping="Wrap" AcceptsReturn="True" Height="52" Margin="0,4,0,8"/>
      <TextBlock Text="Approved requirements"/><TextBox x:Name="HandoffRequirements" Margin="0,4,0,8"/>
      <TextBlock Text="Constraints"/><TextBox x:Name="HandoffConstraints" Margin="0,4,0,8"/>
