          <StackPanel><CheckBox x:Name="CouncilDeepSeekOn" Content="DeepSeek" Checked="CouncilInputChanged" Unchecked="CouncilInputChanged"/><ComboBox x:Name="CouncilDeepSeekModel" DisplayMemberPath="Label" Margin="0,6,0,5" SelectionChanged="CouncilInputChanged"/><TextBlock x:Name="CouncilDeepSeekStatus" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
        </UniformGrid>
        <StackPanel Grid.Row="2"><DockPanel Margin="0,0,0,8"><ComboBox x:Name="CouncilAccess" DockPanel.Dock="Right" Width="260" SelectedIndex="0" SelectionChanged="CouncilInputChanged"><ComboBoxItem Content="Discussion only · no files" Tag="discuss"/><ComboBoxItem Content="Read shared folder" Tag="read"/><ComboBoxItem Content="Isolated Work · reviewed integration" Tag="edit"/></ComboBox><Button x:Name="CouncilBrowse" DockPanel.Dock="Right" Content="Choose folder" Click="CouncilBrowseFolder" Style="{StaticResource Quiet}" Margin="8,0"/><TextBox x:Name="CouncilFolder" IsReadOnly="True" ToolTip="Shared local workspace for every enabled model"/></DockPanel>
          <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="New Council" Click="NewCouncilClicked" Style="{StaticResource Quiet}"/><Button x:Name="CouncilEarlier" DockPanel.Dock="Right" Content="Earlier messages" Click="EarlierCouncilMessages" Style="{StaticResource Quiet}" IsEnabled="False"/><ComboBox x:Name="CouncilHistory" DockPanel.Dock="Right" Width="250" DisplayMemberPath="Label" SelectionChanged="CouncilHistorySelected" ToolTip="Saved Council conversations"/><CheckBox x:Name="CouncilCoordinate" Content="Coordinate and divide into microtasks" IsChecked="True" VerticalAlignment="Center" Checked="CouncilInputChanged" Unchecked="CouncilInputChanged"/></DockPanel>
        </StackPanel>
        <TextBlock x:Name="CouncilNotice" Grid.Row="3" Text="Chat participants discuss and read; they cannot write files. Authorize native Work separately from a microtask. HTC uses isolated Git worktrees and reviewed single-file integration. Folder reads go to selected model providers through their CLI login or API connection. CLI model access and account limits are checked on send. Use New Council to change access." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <ListBox x:Name="CouncilConversation" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Shared Council conversation"><ListBox.ItemTemplate><DataTemplate><Border Background="#171E29" BorderBrush="#27303E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Role}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,10"/><local:MarkdownView SourceText="{Binding Text}" ContextSession="{Binding SourceSession}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Border Grid.Column="2" Background="#151B24" CornerRadius="10" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Microtasks &amp; progress" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CouncilOverall" Text="Choose models to begin" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,8"/><ProgressBar x:Name="CouncilProgress" Height="5" Maximum="100" Margin="0,0,0,14"/><Button x:Name="CouncilCancel" Content="Cancel Council research" Click="CouncilCancelClicked" Style="{StaticResource Quiet}" Margin="0,0,0,12"/></StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Hive Traffic Control" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/><TextBlock x:Name="HiveStatus" Text="No isolated Work tasks" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/><Button x:Name="HiveRetry" Content="Retry unconfirmed HTC request" Click="RetryHiveClicked" Style="{StaticResource Quiet}" Visibility="Collapsed"/><ItemsControl x:Name="HiveTasks"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1B2330" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Traffic}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock Text="{Binding State}" Foreground="{Binding TaskColor}" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="{Binding Busy}" Margin="0,6,0,6"/><TextBlock Text="{Binding Activity}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/><Button Content="Inspect / control" Click="InspectHiveClicked" Style="{StaticResource Quiet}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Research microtasks" FontWeight="SemiBold" Margin="0,12,0,10"/><ItemsControl x:Name="CouncilTasks"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1B2330" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Owner}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,5"/><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><ProgressBar Height="3" Value="{Binding Progress}" IsIndeterminate="{Binding Busy}" Maximum="100" Margin="0,8,0,8"/><TextBlock Text="{Binding Activity}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Timing}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/><Expander Header="Result &amp; operations" Foreground="{StaticResource Ink}" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Result}" TextWrapping="Wrap"/><TextBlock Text="{Binding Operations}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></StackPanel></Expander><Button Content="Run isolated Work…" Click="StartHiveClicked" IsEnabled="{Binding WorkAllowed}" Style="{StaticResource Quiet}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
          </DockPanel></Border>
        </Grid>
        <DockPanel Grid.Row="5" Margin="0,12,0,0"><Button x:Name="CouncilSend" DockPanel.Dock="Right" Content="Send to Council ↗" Click="CouncilSendClicked" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Margin="12,0,0,0"/><TextBox x:Name="CouncilComposer" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CouncilInputChanged" PreviewKeyDown="CouncilComposerKeyDown" AutomationProperties.Name="Message all enabled Council models"/></DockPanel>
      </Grid>
    </Border>

    <Border x:Name="FilePreviewDialog" Grid.RowSpan="2" Background="#E010141C" Visibility="Collapsed" Padding="30"><Border Background="#171E29" BorderBrush="#414C60" BorderThickness="1" CornerRadius="14" Padding="22"><Grid>
