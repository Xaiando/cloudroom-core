          <StackPanel Margin="0,0,12,0"><CheckBox x:Name="CouncilClaudeOn" Content="Claude" Checked="CouncilInputChanged" Unchecked="CouncilInputChanged"/><ComboBox x:Name="CouncilClaudeModel" DisplayMemberPath="Label" Margin="0,6,0,5" SelectionChanged="CouncilInputChanged"/><TextBlock x:Name="CouncilClaudeStatus" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
