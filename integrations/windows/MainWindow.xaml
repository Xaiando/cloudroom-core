    <Border x:Name="AutomationEditor" Grid.RowSpan="2" Background="#E010141C" Visibility="Collapsed"><Border Background="#1B2330" CornerRadius="16" Width="680" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="AutomationEditorTitle" Text="New automation" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Local schedules run while Core is open and Windows is awake. Review the workspace and authorize execution." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
      <TextBlock Text="Name"/><TextBox x:Name="AutomationName" Margin="0,5,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="AutomationScheduleType" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Every N minutes" Tag="interval"/><ComboBoxItem Content="Five-field cron" Tag="cron"/><ComboBoxItem Content="One time (ISO date + offset)" Tag="once"/></ComboBox><TextBox x:Name="AutomationScheduleValue" Grid.Column="1" Text="60"/></Grid>
      <TextBlock Text="IANA timezone (cron schedules)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,5"/><TextBox x:Name="AutomationTimezone" Text="Europe/Oslo" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="AutomationExecutionType" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Script · PowerShell" Tag="powershell"/><ComboBoxItem Content="Script · Node.js" Tag="node"/><ComboBoxItem Content="Script · Python" Tag="python"/><ComboBoxItem Content="Agent · authorized Work conversation" Tag="agent"/></ComboBox><TextBox x:Name="AutomationTimeout" Grid.Column="1" Text="60" ToolTip="Script timeout in seconds"/></Grid>
      <TextBlock Text="Workspace (scripts)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,5"/><ComboBox x:Name="AutomationWorkspace" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,0,12"/>
      <TextBlock Text="Work conversation ID (agent tasks)" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="AutomationConversation" Margin="0,5,0,12"/>
      <TextBlock Text="Script source or agent prompt"/><TextBox x:Name="AutomationSource" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" Margin="0,5,0,12"/>
      <CheckBox x:Name="AutomationEnabled" Content="Enable schedule" IsChecked="True" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/>
      <CheckBox x:Name="AutomationAuthorization" Foreground="{StaticResource Ink}" Margin="0,0,0,14"><TextBlock Text="I authorize this task to execute on this schedule and workspace. Scripts use my Windows account; account isolation is not provided. Agent tasks use an already-authorized Work session." TextWrapping="Wrap" MaxWidth="595"/></CheckBox>
      <TextBlock x:Name="AutomationEditorError" Foreground="#FFC7CF" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelAutomationEditor" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button Content="Save automation" Click="SaveAutomationClicked" Style="{StaticResource Primary}"/></StackPanel>
    </StackPanel></ScrollViewer></Border></Border>
  </Grid>
</Window>
