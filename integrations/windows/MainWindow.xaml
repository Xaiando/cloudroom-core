      <Border Background="#10151D" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,18"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CompareList" AutomationProperties.Name="Additional models"/></ScrollViewer></Border>
      <CheckBox x:Name="NewWorkspaceCheck" Content="Create a new project folder" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/>
