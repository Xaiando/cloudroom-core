    <Border x:Name="NewDialog" Grid.RowSpan="2" Background="#C010141C" Visibility="Collapsed"><Border Background="#1B2330" BorderBrush="#414C60" BorderThickness="1" CornerRadius="16" Width="440" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
