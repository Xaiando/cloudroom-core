<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cloudroom.Desktop</AssemblyName>
    <RootNamespace>Cloudroom.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Cloud Bee</Product>
    <Description>Cloud Bee native Windows desktop, powered by Cloudroom Core</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
